{
  "name": "@rozumari/api",
  "version": "0.0.3",
  "private": false,
  "type": "module",
  "main": "./dist/main.mjs",
  "types": "./dist/main.d.mts",
  "exports": {
    ".": {
      "types": "./dist/api.d.mts",
      "default": "./dist/api.mjs"
    },
    "./home/*": {
      "types": "./dist/modules/home/application/dto/*.dto.d.mts",
      "default": "./dist/modules/home/application/dto/*.dto.mjs"
    },
    "./user/*": {
      "types": "./dist/modules/user/application/dto/*.dto.d.mts",
      "default": "./dist/modules/user/application/dto/*.dto.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "bun run --hot src/main.ts",
    "drizzle": "drizzle-kit --config ./src/shared/infrastructure/persistence/drizzle/drizzle.config.ts",
    "start": "bun run dist/main.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/sql-pg": "catalog:effect",
    "@rozumari/lib": "workspace:*",
    "drizzle-orm": "^1.0.0-rc.4-5d5b77c",
    "effect": "catalog:effect",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@rozumari/oxlint": "workspace:*",
    "@rozumari/tsconfig": "workspace:*",
    "@types/bun": "catalog:dev",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^1.0.0-rc.4-ca0f029",
    "tsdown": "catalog:dev",
    "typescript": "catalog:dev"
  }
}
