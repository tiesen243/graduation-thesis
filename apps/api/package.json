{
  "name": "@rozumari/api",
  "version": "0.0.3",
  "private": false,
  "type": "module",
  "main": "./dist/server.mjs",
  "types": "./dist/server.d.mts",
  "exports": {
    "./auth/*": {
      "types": "./dist/modules/auth/application/dto/*.d.mts",
      "default": "./dist/modules/auth/application/dto/*.mjs"
    },
    "./user/*": {
      "types": "./dist/modules/user/application/dto/*.d.mts",
      "default": "./dist/modules/user/application/dto/*.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "bun run --hot src/server.ts",
    "drizzle": "drizzle-kit --config ./src/shared/infrastructure/persistence/drizzle/drizzle.config.ts",
    "start": "bun run --hot dist/server.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/sql-pg": "catalog:effect",
    "@rozumari/lib": "workspace:*",
    "drizzle-orm": "^1.0.0-rc.4-5d5b77c",
    "effect": "catalog:effect",
    "elysia": "^2.0.0-exp.42",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@rozumari/oxlint": "workspace:*",
    "@rozumari/tsconfig": "workspace:*",
    "@types/bun": "catalog:dev",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^1.0.0-rc.4-ca0f029",
    "tsdown": "catalog:dev",
    "typescript": "catalog:dev"
  }
}
