{
  "name": "@rozumari/api",
  "version": "0.0.7",
  "private": false,
  "bin": "./dist/cli.mjs",
  "type": "module",
  "main": "./dist/main.mjs",
  "scripts": {
    "build": "tsdown",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "bun run --hot src/main.ts",
    "drizzle": "drizzle-kit --config ./src/shared/infrastructure/persistence/drizzle/drizzle.config.ts",
    "start": "bun run dist/main.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:effect",
    "@effect/sql-pg": "catalog:effect",
    "@rozumari/contract": "workspace:*",
    "@rozumari/lib": "workspace:*",
    "drizzle-orm": "^1.0.0-rc.5-ab785fc",
    "effect": "catalog:effect",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@rozumari/oxlint": "workspace:*",
    "@rozumari/tsconfig": "workspace:*",
    "@types/bun": "catalog:dev",
    "@types/pg": "^8.21.0",
    "drizzle-kit": "^1.0.0-rc.5-ab785fc",
    "tsdown": "catalog:dev",
    "typescript": "catalog:dev"
  }
}
