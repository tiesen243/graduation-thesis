{
  "name": "@rozumari/api",
  "version": "0.2.2",
  "private": false,
  "bin": "./dist/cli.mjs",
  "type": "module",
  "main": "./dist/bootstrap.mjs",
  "scripts": {
    "build": "tsdown",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "bun run --hot src/bootstrap.ts",
