    "@rozumari/contract": "workspace:*",
    "@rozumari/lib": "workspace:*",
    "@rozumari/ui": "workspace:*",
    "@tanstack/react-query": "catalog:prod",
    "@tiesen/effect-tanstack-query": "catalog:prod",
    "effect": "catalog:effect",
    "expo": "~58.0.0-preview.4",
    "expo-camera": "~58.0.2",
    "expo-constants": "~58.0.4",
    "expo-device": "~58.0.1",
    "expo-font": "~58.0.1",
    "expo-linking": "~58.0.4",
    "expo-localization": "~58.0.1",
    "expo-location": "~58.0.4",
    "expo-router": "~58.0.5",
    "expo-secure-store": "~58.0.0",
    "expo-splash-screen": "~58.0.1",
    "expo-web-browser": "~58.0.1",
    "i18next": "catalog:i18n",
    "react": "catalog:react",
    "react-i18next": "catalog:i18n",
    "react-native": "catalog:react",
