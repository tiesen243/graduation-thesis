    "@rozumari/lib": "workspace:*",
    "@rozumari/ui": "workspace:*",
    "@tanstack/react-query": "catalog:prod",
    "@tiesen/effect-tanstack-query": "catalog:prod",
    "effect": "catalog:effect",
    "expo": "^57.0.21",
    "expo-constants": "^57.0.17",
    "expo-device": "^57.0.1",
    "expo-font": "^57.0.3",
    "expo-linking": "^57.0.9",
    "expo-localization": "^57.0.1",
    "expo-location": "^57.0.16",
    "expo-router": "~57.0.20",
