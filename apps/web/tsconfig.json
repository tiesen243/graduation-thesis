{
  "extends": "@rozumari/tsconfig/react-package.json",
  "compilerOptions": {
    "types": ["vite/client"],
    "rootDirs": [".", "./.react-router/types"],

    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", ".react-router/types/**/*"],
  "exclude": ["node_modules", "build"]
}
