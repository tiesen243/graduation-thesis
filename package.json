{
  "name": "graduation-thesis",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean && git clean -xdf .turbo node_modules",
    "deploy": "turbo run deploy",
    "format": "oxfmt --check",
    "format:fix": "oxfmt --write",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "tegami": "bun run tegami.ts",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "tegami": "^1.4.0",
    "turbo": "^2.10.12"
  },
  "packageManager": "bun@1.3.0",
  "catalogs": {
    "dev": {
      "@types/bun": "^1.4.0",
      "tsdown": "^0.22.13",
      "typescript": "^7.0.2"
    },
    "prod": {
      "@tanstack/react-query": "^5.102.5"
    },
    "effect": {
      "@effect/platform-bun": ">=4.0.0-rc.112",
      "@effect/sql-pg": ">=4.0.0-rc.112",
      "@effect/atom-react": ">=4.0.0-rc.112",
      "effect": ">=4.0.0-rc.112"
    },
    "react": {
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.5",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "react-native": "^0.86.2"
    },
    "tailwind": {
      "@tailwindcss/vite": "^4.3.3",
      "tailwindcss": "^4.3.3"
    }
  }
}
