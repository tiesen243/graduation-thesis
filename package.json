{
  "name": "rozumari",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean && git clean -xdf .turbo .venv node_modules",
    "dev:mobile": "turbo run dev --filter=@rozumari/mobile --filter=@rozumari/api --continue",
    "dev:web": "turbo run dev --filter=@rozumari/web --filter=@rozumari/api --continue",
    "format": "oxfmt --check",
    "format:fix": "oxfmt --write",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "tegami": "bun run tegami.ts",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "tegami": "^1.5.0",
    "turbo": "^2.11.7"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "ignore"
    }
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=24.20.0"
  },
  "catalogs": {
    "dev": {
      "@types/bun": "^1.4.2",
      "tsdown": "^0.23.0",
      "typescript": "^7.0.2"
    },
    "prod": {
      "@tanstack/react-query": "^5.104.1",
      "@tiesen/effect-tanstack-query": "^0.0.26",
      "react-native-safe-area-context": "~5.9.1"
    },
    "i18n": {
      "i18next": "^26.4.2",
      "react-i18next": "^17.0.16"
    },
    "effect": {
      "@effect/ai-openrouter": "^4.0.2",
      "@effect/platform-bun": "^4.0.2",
      "@effect/sql-pg": "^4.0.2",
      "@effect/atom-react": "^4.0.2",
      "effect": "^4.0.2"
    },
    "react": {
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "react": "^19.3.0",
      "react-dom": "^19.3.0",
      "react-native": "0.88.0-rc.3"
    },
    "tailwind": {
      "@tailwindcss/vite": "^4.3.3",
      "tailwindcss": "^4.3.3",
      "uniwind": "^1.12.2"
    }
  },
  "patchedDependencies": {
    "tegami@1.5.0": "patches/tegami@1.5.0.patch"
  }
}
