{
  "name": "graduation-thesis",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean && git clean -xdf .turbo node_modules",
    "deploy": "turbo run deploy",
    "dev:mobile": "turbo run dev --filter=@rozumari/mobile --filter=@rozumari/api --continue",
    "dev:web": "turbo run dev --filter=@rozumari/web --filter=@rozumari/api --continue",
    "format": "oxfmt --check",
    "format:fix": "oxfmt --write",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "tegami": "bun run tegami.ts",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "tegami": "^1.5.0",
    "turbo": "^2.10.12"
  },
  "packageManager": "bun@1.3.0",
  "catalogs": {
    "dev": {
      "@types/bun": "^1.4.2",
      "tsdown": "^0.23.0",
      "typescript": "^7.0.2"
    },
    "prod": {
      "@tanstack/react-query": "^5.102.8",
      "@tiesen/effect-tanstack-query": "^0.0.20"
    },
    "effect": {
      "@effect/platform-bun": ">=4.0.0-rc.112",
      "@effect/sql-pg": ">=4.0.0-rc.112",
      "@effect/atom-react": ">=4.0.0-rc.112",
      "effect": ">=4.0.0-rc.112"
    },
    "react": {
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "react-native": "0.86.3"
    },
    "tailwind": {
      "@tailwindcss/vite": "^4.3.3",
      "tailwindcss": "^4.3.3",
      "uniwind": "^1.12.0"
    }
  },
  "patchedDependencies": {
    "tegami@1.5.0": "patches/tegami@1.5.0.patch"
  }
}
