{
  "name": "graduation-thesis",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean && git clean -xdf .turbo node_modules",
    "format": "oxfmt --check",
    "format:fix": "oxfmt --write",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "turbo": "^2.10.4"
  },
  "packageManager": "bun@1.3.0",
  "catalogs": {
    "dev": {
      "@types/bun": "^1.3.14",
      "tsdown": "^0.22.7",
      "typescript": "^7.0.2"
    },
    "react": {
      "@types/react": "^19.2.14",
      "@types/react-dom": "^19.2.3",
      "react": "^19.2.3",
      "react-dom": "^19.2.3",
      "react-native": "^0.84.1"
    }
  }
}
