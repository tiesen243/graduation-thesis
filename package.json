{
  "name": "graduation-thesis",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean && git clean -xdf .turbo node_modules",
    "deploy": "turbo run deploy",
    "format": "oxfmt --check",
    "format:fix": "oxfmt --write",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "tegami": "bun run tegami.ts",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "tegami": "^1.3.5",
    "turbo": "^2.10.9"
  },
  "packageManager": "bun@1.3.0",
  "catalogs": {
    "dev": {
      "@types/bun": "^1.3.14",
      "tsdown": "^0.22.13",
      "typescript": "^7.0.2"
    },
    "prod": {
      "@tanstack/react-query": "^5.101.4"
    },
    "effect": {
      "@effect/platform-bun": "4.0.0-beta.105",
      "@effect/sql-pg": "4.0.0-beta.105",
      "effect": "4.0.0-beta.105"
    },
    "react": {
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.4",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "react-native": "^0.86.2"
    },
    "tailwind": {
      "@tailwindcss/vite": "^4.3.3",
      "tailwindcss": "^4.3.3"
    }
  }
}
