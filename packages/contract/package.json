{
  "name": "@rozumari/contract",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./*": {
      "types": "./dist/*.d.mts",
      "default": "./dist/*.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@rozumari/oxlint": "workspace:*",
    "@rozumari/tsconfig": "workspace:*",
    "@types/bun": "catalog:dev",
    "tsdown": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "peerDependencies": {
    "effect": "catalog:effect"
  },
  "dependencies": {
    "@rozumari/lib": "workspace:*"
  }
}
