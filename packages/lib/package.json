{
  "name": "@rozumari/lib",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./*": {
      "types": "./dist/*.d.mts",
      "default": "./dist/*.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
