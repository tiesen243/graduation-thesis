{
  "name": "@rozumari/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/lib/utils.d.mts",
      "default": "./dist/lib/utils.mjs"
    },
    "./components/*": {
      "types": "./dist/components/*.d.mts",
      "default": "./dist/components/*.mjs"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.mts",
      "default": "./dist/hooks/*.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "cnfast": "^0.1.0",
    "lucide-react": "^1.28.0"
  },
  "devDependencies": {
    "@rozumari/oxlint": "workspace:*",
    "@rozumari/tsconfig": "workspace:*",
    "@types/react": "catalog:react",
    "tailwindcss": "catalog:tailwind",
    "tsdown": "catalog:dev",
    "tw-animate-css": "^1.4.0",
    "typescript": "catalog:dev"
  },
  "peerDependencies": {
    "react": "catalog:react"
  }
}
