{
  "name": "@rozumari/ui",
  "version": "0.0.4",
  "private": true,
  "type": "module",
  "exports": {
    "./components/*": {
      "types": "./dist/components/*.d.mts",
      "default": "./dist/components/*.mjs"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.mts",
      "default": "./dist/hooks/*.mjs"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.mts",
      "default": "./dist/lib/*.mjs"
    },
    "./tailwind.css": "./dist/tailwind.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@rozumari/lib": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.4",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.39.0",
    "react-day-picker": "^10.0.1",
    "recharts": "3.8.0"
  },
  "devDependencies": {
    "@rozumari/oxlint": "workspace:*",
    "@rozumari/tsconfig": "workspace:*",
    "@types/react": "catalog:react",
    "tailwindcss": "catalog:tailwind",
    "tsdown": "catalog:dev",
    "tw-animate-css": "^1.4.0",
    "typescript": "catalog:dev"
  },
  "peerDependencies": {
    "@effect/atom-react": "catalog:effect",
    "effect": "catalog:effect",
    "react": "catalog:react"
  }
}
