{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "tui",
  "futureFlags": {
    "experimentalPythonWorkspaces": true
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".cache/tsbuildinfo.json", "dist/**"]
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "persistent": true
    },
    "typecheck": {
      "outputs": [".cache/tsbuildinfo.json"]
    }
  },
  "globalEnv": [
    "CORS_ORIGIN",

    "DATABASE_URL",

    "AUTH_SECRET",

    "AUTH_FACEBOOK_ID",
    "AUTH_FACEBOOK_SECRET",

    "AUTH_GITHUB_ID",
    "AUTH_GITHUB_SECRET",

    "AUTH_GOOGLE_ID",
    "AUTH_GOOGLE_SECRET",

    "AUTH_TWITTER_ID",
    "AUTH_TWITTER_SECRET",

    "OPENROUTER_API_KEY",
    "RESEND_API_KEY",
    "TURNSTILE_KEY",

    "VITE_APP_NAME",
    "VITE_API_URL",
    "VITE_TURNSTILE_KEY",
    "VITE_BYPASS_TOKEN",

    "EXPO_PUBLIC_API_URL",
    "EXPO_PUBLIC_WEB_URL",
    "EXPO_PUBLIC_TURNSTILE_KEY"
  ],
  "globalPassThroughEnv": [
    "NODE_ENV",
    "CI",
    "npm_lifecycle_event",

    "VERCEL",
    "VERCEL_URL",
    "VERCEL_BRANCH_URL",
    "VERCEL_PROJECT_PRODUCTION_URL"
  ]
}
