{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".cache/tsbuildinfo.json", "dist/**", "build/**"]
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "persistent": true
    },
    "deploy": {
      "dependsOn": ["@rozumari/api#build", "@rozumari/web#build"],
      "interactive": true,
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [".cache/tsbuildinfo.json"]
    }
  },
  "globalEnv": [
    "CORS_ORIGIN",
    "DATABASE_URL",

    "AUTH_SECRET",

    "AUTH_GOOGLE_ID",
    "AUTH_GOOGLE_SECRET",

    "PUBLIC_API_URL"
  ],
  "globalPassThroughEnv": [
    "NODE_ENV",
    "CI",
    "npm_lifecycle_event",
    "VERCEL",
    "VERCEL_URL",
    "VERCEL_PROJECT_PRODUCTION_URL"
  ]
}
